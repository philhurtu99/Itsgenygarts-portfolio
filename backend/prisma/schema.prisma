generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 Int                   @id @default(autoincrement())
  name               String
  nameFr             String?
  nameEn             String?
  price              Decimal               @db.Decimal(10, 2)
  description        String?
  descriptionFr      String?
  descriptionEn      String?
  sizeFitFr          String?
  sizeFitEn          String?
  materialsFr        String?
  materialsEn        String?
  careFr             String?
  careEn             String?
  sizeGuideUrl       String?
  stockQuantity      Int                   @default(0)
  soldOut            Boolean               @default(false)
  showSoldVariants   Boolean               @default(false)
  mainImageUrl       String?
  isDeleted          Boolean               @default(false)
  isDraft            Boolean               @default(false)
  isFeatured         Boolean               @default(false)
  isReference        Boolean               @default(false)
  shippingQC         Decimal               @default(0) @db.Decimal(10, 2)
  shippingCA         Decimal               @default(0) @db.Decimal(10, 2)
  shippingUS         Decimal               @default(0) @db.Decimal(10, 2)
  shippingINT        Decimal               @default(0) @db.Decimal(10, 2)
  packageWeightGrams Int?
  packageLengthCm    Decimal?              @db.Decimal(8, 2)
  packageWidthCm     Decimal?              @db.Decimal(8, 2)
  packageHeightCm    Decimal?              @db.Decimal(8, 2)
  customsDescription String?
  customsWeightGrams Decimal?              @db.Decimal(10, 2)
  customsOriginCountry String?
  customsHsCode      String?
  customsProfileKey  String?
  categoryId         Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  category           Category?             @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  variants           ProductVariant[]
  collections        ProductCollection[]
  quoteItems         QuoteRequestItem[]
  references         ProductReference[]
  shippingRates      ProductShippingRate[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  favoriteItems      FavoriteItem[]
  reservations       StockReservation[]
}

model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int
  variantId Int?
  imageUrl  String
  publicId  String
  order     Int             @default(0)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
}

model ProductVariant {
  id            Int                @id @default(autoincrement())
  productId     Int
  colorHex      String?
  status        String             @default("AVAILABLE")
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  cartItems     CartItem[]
  favoriteItems FavoriteItem[]
  orderItems    OrderItem[]
  reservations  StockReservation[]

  @@index([productId, status, sortOrder])
}

model YarnProduct {
  id                 Int           @id @default(autoincrement())
  name               String
  nameFr             String?
  nameEn             String?
  price              Decimal       @db.Decimal(10, 2)
  description        String?
  descriptionFr      String?
  descriptionEn      String?
  stockQuantity      Int           @default(0)
  soldOut            Boolean       @default(false)
  mainImageUrl       String?
  isDeleted          Boolean       @default(false)
  packageWeightGrams Int?
  packageLengthCm    Decimal?      @db.Decimal(8, 2)
  packageWidthCm     Decimal?      @db.Decimal(8, 2)
  packageHeightCm    Decimal?      @db.Decimal(8, 2)
  customsDescription String?
  customsWeightGrams Decimal?      @db.Decimal(10, 2)
  customsOriginCountry String?
  customsHsCode      String?
  customsProfileKey  String?
  categoryId         Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  category           YarnCategory? @relation(fields: [categoryId], references: [id])
  images             YarnImage[]
}

model YarnImage {
  id            Int         @id @default(autoincrement())
  yarnProductId Int
  imageUrl      String
  publicId      String
  order         Int         @default(0)
  yarnProduct   YarnProduct @relation(fields: [yarnProductId], references: [id], onDelete: Cascade)
}

model YarnCategory {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  nameFr        String?
  nameEn        String?
  description   String?
  descriptionFr String?
  descriptionEn String?
  customsProfileKey String?
  customsOriginCountry String?
  imageUrl      String?
  displayOrder  Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  yarnProducts  YarnProduct[]
}

model Category {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  nameFr        String?
  nameEn        String?
  description   String?
  descriptionFr String?
  descriptionEn String?
  customsProfileKey String?
  customsOriginCountry String?
  imageUrl      String?
  displayOrder  Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  products      Product[]
}

model Collection {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  description  String?
  imageUrl     String?
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  products     ProductCollection[]
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  referrer  String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model ProductCollection {
  productId    Int
  collectionId Int
  addedAt      DateTime   @default(now())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model QuoteRequest {
  id               Int                @id @default(autoincrement())
  customerName     String
  customerEmail    String
  customerPhone    String?
  shippingAddress  String
  city             String
  postalCode       String
  country          String
  customerLanguage String             @default("en")
  message          String?
  status           String             @default("Pending")
  totalAmount      Decimal            @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())
  completedAt      DateTime?
  items            QuoteRequestItem[]
}

model QuoteRequestItem {
  id              Int          @id @default(autoincrement())
  quoteRequestId  Int
  productId       Int?
  productName     String
  productPrice    Decimal      @db.Decimal(10, 2)
  productImageUrl String?
  quantity        Int
  subtotal        Decimal      @db.Decimal(10, 2)
  quoteRequest    QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model ProductReference {
  id           Int           @id @default(autoincrement())
  name         String
  imageUrl     String?
  category     String?
  productId    Int?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  customOrders CustomOrder[]
}

model CustomModelOption {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  displayName  String
  customOrders CustomOrder[]
}

model CustomOrderCategoryDef {
  id           Int     @id @default(autoincrement())
  name         String
  nameFr       String?
  nameEn       String?
  code         String  @unique
  icon         String?
  options      String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
}

model CustomOrder {
  id                  Int                  @id @default(autoincrement())
  productReferenceId  Int?
  customModelOptionId Int?
  category            String
  colorStyle          String
  selectedColors      String?
  colorChangingTheme  String?
  rainbowMood         String?
  selectedOptions     String?
  description         String?
  customerName        String
  customerEmail       String
  customerPhone       String?
  customerAddress     String
  customerCity        String
  customerProvince    String?
  customerPostalCode  String
  customerCountry     String
  customerLanguage    String               @default("en")
  status              String               @default("NEW")
  source              String               @default("WEBSITE")
  price               Decimal?             @db.Decimal(10, 2)
  amountPaid          Decimal              @default(0) @db.Decimal(10, 2)
  paymentStatus       String               @default("UNPAID")
  stripeSessionId     String?
  stripePaymentId     String?
  paidAt              DateTime?
  createdAtUtc        DateTime             @default(now())
  productReference    ProductReference?    @relation(fields: [productReferenceId], references: [id], onDelete: SetNull)
  customModelOption   CustomModelOption?   @relation(fields: [customModelOptionId], references: [id], onDelete: SetNull)
  images              CustomOrderImage[]
  payments            CustomOrderPayment[]
}

model CustomOrderPayment {
  id              Int         @id @default(autoincrement())
  customOrderId   Int
  amount          Decimal     @db.Decimal(10, 2)
  kind            String
  method          String
  status          String      @default("PENDING")
  stripePaymentId String?     @unique
  stripeSessionId String?     @unique
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  customOrder     CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId, status])
}

model CustomOrderImage {
  id               Int         @id @default(autoincrement())
  customOrderId    Int
  fileName         String
  contentType      String
  storagePathOrUrl String
  purpose          String      @default("REFERENCE")
  uploadedAtUtc    DateTime    @default(now())
  customOrder      CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId, purpose])
}

model PersonalizedQuote {
  id                 Int                      @id @default(autoincrement())
  description        String
  customerName       String
  customerEmail      String
  customerPhone      String?
  customerAddress    String
  customerCity       String
  customerProvince   String?
  customerPostalCode String
  customerCountry    String
  customerLanguage   String                   @default("en")
  status             String                   @default("NEW")
  price              Decimal?                 @db.Decimal(10, 2)
  stripeSessionId    String?
  stripePaymentId    String?
  paidAt             DateTime?
  createdAtUtc       DateTime                 @default(now())
  images             PersonalizedQuoteImage[]
}

model PersonalizedQuoteImage {
  id                  Int               @id @default(autoincrement())
  personalizedQuoteId Int
  fileName            String
  contentType         String
  storagePathOrUrl    String
  uploadedAtUtc       DateTime          @default(now())
  personalizedQuote   PersonalizedQuote @relation(fields: [personalizedQuoteId], references: [id], onDelete: Cascade)
}

model ShippingZone {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  countries    String
  isActive     Boolean               @default(true)
  displayOrder Int                   @default(0)
  rates        ProductShippingRate[]
}

model ProductShippingRate {
  id             Int          @id @default(autoincrement())
  productId      Int
  shippingZoneId Int
  price          Decimal      @db.Decimal(10, 2)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  shippingZone   ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@unique([productId, shippingZoneId])
}

model CurrencyRate {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  symbol   String
  rate     Decimal @db.Decimal(12, 6)
  isActive Boolean @default(true)
}

model Order {
  id                             Int                @id @default(autoincrement())
  customerName                   String
  customerEmail                  String
  customerPhone                  String?
  customerAddress                String
  customerCity                   String
  customerProvince               String?
  customerPostalCode             String
  customerCountry                String
  customerLanguage               String             @default("en")
  importFeesAcceptedAt           DateTime?
  importFeesPolicyVersion        String?
  importFeesPolicyLanguage       String?
  importFeesPolicyText           String?
  currency                       String             @default("CAD")
  subtotal                       Decimal            @db.Decimal(10, 2)
  shippingTotal                  Decimal            @db.Decimal(10, 2)
  shippingProvider               String?
  shippingServiceCode            String?
  shippingServiceName            String?
  shippingRateId                 String?
  shippingTrackingIncluded       Boolean            @default(false)
  shippingEstimatedDays          Int?
  shippingPackage                Json?
  shippingTrackingNumber         String?
  shippingTrackingUrl            String?
  shippingTransactionId          String?
  shippingLabelPurchaseStartedAt DateTime?
  shippingLabelCreatedAt         DateTime?
  total                          Decimal            @db.Decimal(10, 2)
  status                         String             @default("PENDING")
  stripeSessionId                String?
  stripePaymentId                String?
  paidAt                         DateTime?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  items                          OrderItem[]
  reservations                   StockReservation[]
}

model StockReservation {
  id               Int             @id @default(autoincrement())
  orderId          Int
  productId        Int
  productVariantId Int?
  quantity         Int
  expiresAt        DateTime
  createdAt        DateTime        @default(now())
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([productId])
  @@index([productVariantId])
}

model OrderItem {
  id                   Int             @id @default(autoincrement())
  orderId              Int
  productId            Int?
  productVariantId     Int?
  productName          String
  productImageUrl      String?
  variantLabelSnapshot String?
  variantImageUrl      String?
  unitPrice            Decimal         @db.Decimal(10, 2)
  shippingPrice        Decimal         @default(0) @db.Decimal(10, 2)
  quantity             Int
  subtotal             Decimal         @db.Decimal(10, 2)
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant       ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  email        String           @unique
  passwordHash String
  role         String           @default("User")
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  pushTokens   AdminPushToken[]
}

model AdminPushToken {
  id         Int      @id @default(autoincrement())
  userId     Int?
  token      String   @unique
  platform   String?
  deviceName String?
  appVersion String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
}

model Customer {
  id                   Int            @id @default(autoincrement())
  name                 String
  email                String         @unique
  passwordHash         String
  isActive             Boolean        @default(true)
  emailVerified        Boolean        @default(false)
  newsletterConsent    Boolean        @default(false)
  preferredLanguage    String         @default("en")
  verificationToken    String?        @unique
  resetPasswordToken   String?        @unique
  resetPasswordExpires DateTime?
  deleteAccountToken   String?        @unique
  deleteAccountExpires DateTime?
  createdAt            DateTime       @default(now())
  cartItems            CartItem[]
  favoriteItems        FavoriteItem[]
}

model AdminNote {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  body       String
  authorId   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([createdAt])
}

model CartItem {
  id               Int             @id @default(autoincrement())
  customerId       Int
  productId        Int
  productVariantId Int?
  quantity         Int             @default(1)
  createdAt        DateTime        @default(now())
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([customerId, productId])
  @@index([productVariantId])
}

model FavoriteItem {
  id               Int             @id @default(autoincrement())
  customerId       Int
  productId        Int
  productVariantId Int?
  createdAt        DateTime        @default(now())
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([customerId, productId])
  @@index([productVariantId])
}
